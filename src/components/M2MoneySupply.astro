---
import m2Data from "../data/m2.json";

const labels = JSON.stringify(m2Data.data.map((d) => d.year));
const values = JSON.stringify(m2Data.data.map((d) => d.m2));
const currentM2 = m2Data.data[m2Data.data.length - 1].m2;
const startM2 = m2Data.data[0].m2;
const growthMultiple = (currentM2 / startM2).toFixed(0);
---

<div class="bg-navy-900 rounded-2xl p-6 border border-navy-700">
  <div class="flex items-center justify-between mb-4 flex-wrap gap-4">
    <div>
      <h2 class="text-xl font-bold text-white">M2 Money Supply</h2>
      <p class="text-sm text-navy-400 mt-1">US dollars in circulation (trillions)</p>
    </div>
    <div class="text-right">
      <span class="text-2xl font-mono font-bold text-red-accent">
        ${currentM2.toFixed(1)}T
      </span>
      <p class="text-xs text-navy-400">{growthMultiple}x since 1971</p>
    </div>
  </div>
  <div class="relative" style="height: 350px;">
    <canvas id="m2Chart"></canvas>
  </div>
  <p class="text-xs text-navy-500 mt-3">
    Note the exponential acceleration after 2008 (Financial Crisis) and 2020 (COVID stimulus).
    M2 grew more from 2020-2021 than in the entire decade of the 1970s.
  </p>
</div>

<script define:vars={{ labels, values }}>
  const labelsArr = JSON.parse(labels);
  const valuesArr = JSON.parse(values);

  async function initChart() {
    const { Chart, registerables } = await import("chart.js");
    Chart.register(...registerables);

    const ctx = document.getElementById("m2Chart");
    if (!ctx) return;

    new Chart(ctx, {
      type: "bar",
      data: {
        labels: labelsArr,
        datasets: [
          {
            label: "M2 Supply ($T)",
            data: valuesArr,
            backgroundColor: labelsArr.map((year) => {
              if (year >= 2020) return "rgba(239, 68, 68, 0.7)";
              if (year >= 2008) return "rgba(239, 68, 68, 0.45)";
              return "rgba(239, 68, 68, 0.25)";
            }),
            borderColor: labelsArr.map((year) => {
              if (year >= 2020) return "#ef4444";
              if (year >= 2008) return "rgba(239, 68, 68, 0.7)";
              return "rgba(239, 68, 68, 0.5)";
            }),
            borderWidth: 1,
            borderRadius: 2,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          intersect: false,
          mode: "index",
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: "#161d35",
            borderColor: "#2a3558",
            borderWidth: 1,
            titleColor: "#e2e8f0",
            bodyColor: "#e2e8f0",
            bodyFont: { family: "JetBrains Mono, monospace" },
            callbacks: {
              label: (ctx) => `$${ctx.parsed.y.toFixed(2)} trillion`,
            },
          },
        },
        scales: {
          x: {
            ticks: {
              color: "#5a6a8a",
              maxTicksLimit: 12,
            },
            grid: { color: "rgba(42, 53, 88, 0.5)" },
          },
          y: {
            ticks: {
              color: "#5a6a8a",
              callback: (v) => "$" + v + "T",
            },
            grid: { color: "rgba(42, 53, 88, 0.5)" },
            beginAtZero: true,
          },
        },
      },
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initChart);
  } else {
    initChart();
  }
</script>
