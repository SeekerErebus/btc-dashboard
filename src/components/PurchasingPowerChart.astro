---
import cpiData from "../data/cpi.json";
import btcData from "../data/btc.json";

const baseCpi = cpiData.data[0].cpi;
const purchasingPower = cpiData.data.map((d) => ({
  year: d.year,
  value: Math.round((baseCpi / d.cpi) * 10000) / 100,
}));

// Build BTC purchasing power: if you put $1 into BTC in 2010, what is it worth?
// Indexed so 2010 = $1.00 (same visual frame as dollar decay)
const btcStartPrice = btcData.data[0].price; // 2010 price
const btcPurchasingPower = cpiData.data.map((d) => {
  const btcEntry = btcData.data.find((b) => b.year === d.year);
  if (!btcEntry) return null;
  return {
    year: d.year,
    // Normalize: BTC value indexed to $1.00 at 2010
    value: btcEntry.price / btcStartPrice,
  };
}).filter(Boolean);

const labels = JSON.stringify(purchasingPower.map((d) => d.year));
const dollarValues = JSON.stringify(purchasingPower.map((d) => d.value));

// For the BTC overlay, we need to align years with the full CPI timeline
const btcOverlay = cpiData.data.map((d) => {
  const entry = btcPurchasingPower.find((b) => b.year === d.year);
  return entry ? entry.value : null;
});
const btcOverlayJson = JSON.stringify(btcOverlay);

const currentDollarPP = purchasingPower[purchasingPower.length - 1].value;
const btcLastEntry = btcPurchasingPower[btcPurchasingPower.length - 1];
const btcMultiple = btcLastEntry ? Math.round(btcLastEntry.value).toLocaleString() : "N/A";
---

<div class="bg-navy-900 rounded-2xl p-6 border border-navy-700">
  <div class="flex items-center justify-between mb-4 flex-wrap gap-4">
    <div>
      <h2 class="text-xl font-bold text-white">Dollar vs Bitcoin: Purchasing Power</h2>
      <p class="text-sm text-navy-400 mt-1">Dollar indexed to $1.00 in 1971 | BTC indexed to $1.00 in 2010</p>
    </div>
    <div class="flex items-center gap-4">
      <div class="text-right">
        <span class="text-lg font-mono font-bold text-red-accent">
          ${currentDollarPP.toFixed(2)}
        </span>
        <p class="text-xs text-navy-400">Dollar now</p>
      </div>
      <div class="text-right">
        <span class="text-lg font-mono font-bold text-btc">
          ${btcMultiple}
        </span>
        <p class="text-xs text-navy-400">$1 BTC (2010)</p>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-4 mb-3">
    <label class="flex items-center gap-2 text-sm text-navy-400 cursor-pointer select-none">
      <input type="checkbox" id="showBtcOverlay" class="accent-btc w-4 h-4" checked />
      <span>Show BTC growth</span>
    </label>
    <label class="flex items-center gap-2 text-sm text-navy-400 cursor-pointer select-none">
      <input type="checkbox" id="ppLogScale" class="accent-btc w-4 h-4" />
      <span>Log scale</span>
    </label>
  </div>

  <div class="relative" style="height: 400px;">
    <canvas id="purchasingPowerChart"></canvas>
  </div>

  <p class="text-xs text-navy-500 mt-3">
    The dollar line shows the relentless erosion of purchasing power since the end of Bretton Woods.
    The BTC line (log scale recommended) shows the opposite trajectory: a $1 investment in 2010 Bitcoin.
  </p>
</div>

<script define:vars={{ labels, dollarValues, btcOverlayJson }}>
  const labelsArr = JSON.parse(labels);
  const dollarArr = JSON.parse(dollarValues);
  const btcArr = JSON.parse(btcOverlayJson);

  let chartInstance = null;

  async function initChart() {
    const { Chart, registerables } = await import("chart.js");
    Chart.register(...registerables);

    const ctx = document.getElementById("purchasingPowerChart");
    if (!ctx) return;

    function createChart(showBtc, useLog) {
      if (chartInstance) chartInstance.destroy();

      const datasets = [
        {
          label: "Dollar Purchasing Power ($)",
          data: dollarArr,
          borderColor: "#ef4444",
          backgroundColor: "rgba(239, 68, 68, 0.08)",
          borderWidth: 2.5,
          fill: true,
          tension: 0.3,
          pointRadius: 0,
          pointHoverRadius: 6,
          pointHoverBackgroundColor: "#ef4444",
          yAxisID: "y",
        },
      ];

      if (showBtc) {
        datasets.push({
          label: "BTC Value of $1 (2010)",
          data: btcArr,
          borderColor: "#F7931A",
          backgroundColor: "rgba(247, 147, 26, 0.08)",
          borderWidth: 2.5,
          fill: false,
          tension: 0.3,
          pointRadius: 0,
          pointHoverRadius: 6,
          pointHoverBackgroundColor: "#F7931A",
          borderDash: [6, 3],
          yAxisID: "y2",
          spanGaps: true,
        });
      }

      const yConfig = {
        y: {
          type: "linear",
          position: "left",
          ticks: {
            color: "#ef4444",
            callback: (v) => "$" + v.toFixed(2),
          },
          grid: { color: "rgba(42, 53, 88, 0.5)" },
          min: 0,
          max: 1.1,
          title: {
            display: true,
            text: "Dollar value",
            color: "#ef4444",
            font: { size: 11 },
          },
        },
      };

      if (showBtc) {
        yConfig.y2 = {
          type: useLog ? "logarithmic" : "linear",
          position: "right",
          ticks: {
            color: "#F7931A",
            callback: (v) => {
              if (useLog) {
                const allowed = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000];
                if (allowed.includes(v)) return "$" + v.toLocaleString();
                return "";
              }
              return "$" + v.toLocaleString();
            },
          },
          grid: { drawOnChartArea: false },
          title: {
            display: true,
            text: "BTC value of $1",
            color: "#F7931A",
            font: { size: 11 },
          },
        };
      }

      chartInstance = new Chart(ctx, {
        type: "line",
        data: {
          labels: labelsArr,
          datasets,
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            intersect: false,
            mode: "index",
          },
          plugins: {
            legend: {
              display: showBtc,
              labels: {
                color: "#e2e8f0",
                usePointStyle: true,
                padding: 16,
              },
            },
            tooltip: {
              backgroundColor: "#161d35",
              borderColor: "#2a3558",
              borderWidth: 1,
              titleColor: "#e2e8f0",
              bodyColor: "#e2e8f0",
              bodyFont: { family: "JetBrains Mono, monospace" },
              callbacks: {
                label: (tooltipCtx) => {
                  const val = tooltipCtx.parsed.y;
                  if (val === null) return null;
                  if (tooltipCtx.datasetIndex === 0) {
                    return `Dollar: $${val.toFixed(2)} of original $1.00`;
                  }
                  return `BTC: $${val.toLocaleString(undefined, { maximumFractionDigits: 0 })} from $1`;
                },
              },
            },
          },
          scales: {
            x: {
              ticks: {
                color: "#5a6a8a",
                maxTicksLimit: 12,
              },
              grid: { color: "rgba(42, 53, 88, 0.5)" },
            },
            ...yConfig,
          },
        },
      });
    }

    createChart(true, true); // Default: show BTC overlay with log scale

    const btcToggle = document.getElementById("showBtcOverlay");
    const logToggle = document.getElementById("ppLogScale");

    function rebuild() {
      createChart(btcToggle?.checked ?? true, logToggle?.checked ?? false);
    }

    btcToggle?.addEventListener("change", rebuild);
    logToggle?.addEventListener("change", rebuild);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initChart);
  } else {
    initChart();
  }
</script>
