---
import cpiData from "../data/cpi.json";

const baseCpi = cpiData.data[0].cpi;
const purchasingPower = cpiData.data.map((d) => ({
  year: d.year,
  value: Math.round((baseCpi / d.cpi) * 10000) / 100,
}));

const labels = JSON.stringify(purchasingPower.map((d) => d.year));
const values = JSON.stringify(purchasingPower.map((d) => d.value));
---

<div class="bg-navy-900 rounded-2xl p-6 border border-navy-700">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-xl font-bold text-white">Dollar Purchasing Power</h2>
      <p class="text-sm text-navy-400 mt-1">Indexed to $1.00 in 1971 (Nixon Shock)</p>
    </div>
    <div class="text-right">
      <span class="text-2xl font-mono font-bold text-red-accent">
        ${purchasingPower[purchasingPower.length - 1].value.toFixed(2)}
      </span>
      <p class="text-xs text-navy-400">of original $1.00</p>
    </div>
  </div>
  <div class="relative" style="height: 350px;">
    <canvas id="purchasingPowerChart"></canvas>
  </div>
</div>

<script define:vars={{ labels, values }}>
  const labelsArr = JSON.parse(labels);
  const valuesArr = JSON.parse(values);

  async function initChart() {
    const { Chart, registerables } = await import("chart.js");
    Chart.register(...registerables);

    const ctx = document.getElementById("purchasingPowerChart");
    if (!ctx) return;

    new Chart(ctx, {
      type: "line",
      data: {
        labels: labelsArr,
        datasets: [
          {
            label: "Purchasing Power ($)",
            data: valuesArr,
            borderColor: "#ef4444",
            backgroundColor: "rgba(239, 68, 68, 0.1)",
            borderWidth: 2,
            fill: true,
            tension: 0.3,
            pointRadius: 0,
            pointHoverRadius: 6,
            pointHoverBackgroundColor: "#ef4444",
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          intersect: false,
          mode: "index",
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: "#161d35",
            borderColor: "#2a3558",
            borderWidth: 1,
            titleColor: "#e2e8f0",
            bodyColor: "#e2e8f0",
            bodyFont: { family: "JetBrains Mono, monospace" },
            callbacks: {
              label: (ctx) => `$${ctx.parsed.y.toFixed(2)} of original $1.00`,
            },
          },
        },
        scales: {
          x: {
            ticks: {
              color: "#5a6a8a",
              maxTicksLimit: 12,
            },
            grid: { color: "rgba(42, 53, 88, 0.5)" },
          },
          y: {
            ticks: {
              color: "#5a6a8a",
              callback: (v) => "$" + v.toFixed(2),
            },
            grid: { color: "rgba(42, 53, 88, 0.5)" },
            min: 0,
            max: 1.1,
          },
        },
      },
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initChart);
  } else {
    initChart();
  }
</script>
